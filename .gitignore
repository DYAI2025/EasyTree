# Dependencies
node_modules/

# Build outputs
dist/
.next/
.turbo/
coverage/

# Playwright runtime artifacts (EYT-58b)
test-results/
playwright-report/

# Environment files (never commit real credentials)
.env
.env.*
!.env.example

# Logs & misc
*.log
.DS_Store

# Untracked Arbeitsverzeichnisse im Repo-Root (siehe CLAUDE.md, Konventionen).
# penpot ist ein eigener Upstream-Clone, _sprint2-transfer haelt Git-Bundles.
# Ohne diese Eintraege nimmt ein `git add -A` beide versehentlich mit — einmal
# passiert, als penpot als Gitlink im Index landete.
penpot/
_sprint2-transfer/

# Agent runtime state — not product source
/.claude-flow/
/.claude/homunculus/

# PRIL-Laufzustand (Plumbline). Kein Repoinhalt.
.plumbline/

# Cloudflare-Buildartefakte (EYT-142). Ohne diese Eintraege nimmt ein
# `git add -A` den kompletten OpenNext-Output mit — dasselbe Muster wie bei
# penpot/ weiter oben, nur groesser.
.open-next/
.wrangler/
.wrangler-dry/
