{
  "name": "@easytree/domain",
  "version": "0.0.0",
  "private": true,
  "description": "easyTree Domainkern — reine Typen, Invarianten, Zustandsmodelle ohne Framework (EYT-46, ADR-002 §5)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
